NODE_ENV=development | production | test
PORT=api listen port
LOG_LEVEL=winston level

DB_HOST=postgres host
DB_PORT=postgres port
DB_NAME=postgres database
DB_USER=postgres user
DB_PASSWORD=postgres password

JWT_SECRET=random signing secret min 32 chars
JWT_EXPIRES_IN=access token lifetime e.g. 7d or 1h

RESEND_API_KEY=resend api key
RESEND_EMAIL_SENDER=from email address

FRONTEND_URL=frontend base url

GOOGLE_APPLICATION_CREDENTIALS=google application credentials path
GOOGLE_API_KEY=google api key
GOOGLE_AI_MODEL=google ai model

GCS_BUCKET_NAME=google cloud storage bucket name
GCS_LOCATION=google cloud storage location
GCS_STORAGE_CLASS=google cloud storage storage class
GCS_LANGUAGE_CODE=google cloud speech language code

BULL_ADMIN_PORT=bull admin port

REDIS_HOST=redis host
REDIS_PORT=redis port
